    "START_TIME": "2026-10-04T14:59:09.034000-07:00",
    "ROLE_NAME": "ACCOUNTADMIN",
    "WAREHOUSE_NAME": "TASTY_BYTES_DBT_WH",
    "WAREHOUSE_SIZE": "Small",
    "QUERY_TYPE": "SELECT",
