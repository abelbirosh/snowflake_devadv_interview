    "QUERY_TEXT": "SELECT table_name, row_count, bytes, clustering_key, is_transient\nFROM TASTY_BYTES_DBT_DB.INFORMATION_SCHEMA.TABLES\nWHERE table_schema = 'DEV' AND table_type = 'BASE TABLE'"
  },
  {
    "QUERY_ID": "01c77ddb-0108-c600-0011-5b520003e0b6",
    "START_TIME": "2026-10-03T15:19:14.137000-07:00",
    "ROLE_NAME": "ACCOUNTADMIN",
    "WAREHOUSE_NAME": "TASTY_BYTES_DBT_WH",
