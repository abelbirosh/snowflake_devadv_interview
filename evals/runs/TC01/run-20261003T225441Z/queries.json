  {
    "QUERY_ID": "01c77e01-0108-c600-0011-5b520003e3ce",
    "START_TIME": "2026-10-03T15:57:19.146000-07:00",
    "ROLE_NAME": "ACCOUNTADMIN",
    "WAREHOUSE_NAME": "TASTY_BYTES_DBT_WH",
