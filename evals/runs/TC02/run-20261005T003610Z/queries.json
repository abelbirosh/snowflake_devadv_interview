    "QUERY_TEXT": "WITH runs AS (\n  SELECT f.value::STRING AS run_id FROM TABLE(FLATTEN(INPUT => ARRAY_CONSTRUCT('01c77787-0208-c3ea-0011-5b520001f266', '01c77799-0208-bb91-0011-5b5200022262'))) f\n),\np AS (\n  SELECT r.run_id, h.start_time, h.end_time, h.user_name\n  FROM runs r\n  LEFT JOIN SNOWFLAKE.ACCOUNT_USAGE.QUERY_HISTORY h\n    ON h.query_id = r.run_id AND h.start_time >= '2026-10-02 12:19:05.084 -0700'::TIMESTAMP_LTZ - INTERVAL '1 minute'\n)\nSELECT p.run_id, p.start_time, p.start_time IS NOT NULL AS in_account_usage,\n       COUNT(o.query_id) AS overlapping_dbt_runs\nFROM p\nLEFT JOIN SNOWFLAKE.ACCOUNT_USAGE.QUERY_HISTORY o\n  ON o.user_name = p.user_name AND o.query_id <> p.run_id\n AND o.start_time < p.end_time AND o.end_time > p.start_time\n AND o.query_type = 'CALL' AND o.query_text ILIKE 'EXECUTE DBT PROJECT%'\n AND o.start_time >= '2026-10-02 12:19:05.084 -0700'::TIMESTAMP_LTZ - INTERVAL '1 day'\nGROUP BY 1, 2, 3\nORDER BY p.start_time DESC NULLS FIRST /* dbt-cost-tuning */"
