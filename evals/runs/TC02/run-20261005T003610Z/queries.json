    "QUERY_TEXT": "WITH reads AS (\n  SELECT ah.query_id, ah.user_name, ah.query_start_time,\n         UPPER(f.value:\"objectName\"::STRING) AS obj\n  FROM SNOWFLAKE.ACCOUNT_USAGE.ACCESS_HISTORY ah,\n       LATERAL FLATTEN(ah.direct_objects_accessed) f\n  WHERE ah.query_start_time >= DATEADD(day, -30, CURRENT_TIMESTAMP())\n    AND UPPER(f.value:\"objectName\"::STRING) IN (\n      'TASTY_BYTES_DBT_DB.DEV.ORDERS',\n      'TASTY_BYTES_DBT_DB.DEV.CUSTOMER_LOYALTY_METRICS',\n      'TASTY_BYTES_DBT_DB.DEV.SALES_METRICS_BY_LOCATION'\n    )\n)\nSELECT r.obj,\n       COUNT(DISTINCT r.query_id)                                   AS reads,\n       COUNT(DISTINCT r.user_name)                                  AS readers,\n       ROUND(AVG(h.partitions_scanned / NULLIF(h.partitions_total, 0)), 2) AS avg_scan_ratio\nFROM reads r\nJOIN SNOWFLAKE.ACCOUNT_USAGE.QUERY_HISTORY h\n  ON h.query_id = r.query_id AND h.start_time >= DATEADD(day, -30, CURRENT_TIMESTAMP())\nWHERE h.query_text NOT ILIKE '%\"app\": \"dbt\"%'\n  AND h.query_text NOT ILIKE '%/* dbt-cost-tuning */%'\nGROUP BY 1 /* dbt-cost-tuning */"
