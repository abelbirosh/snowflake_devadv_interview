  {
    "QUERY_ID": "01c77e0d-0108-c600-0011-5b520003e4a6",
    "START_TIME": "2026-10-03T16:09:31.228000-07:00",
    "ROLE_NAME": "ACCOUNTADMIN",
    "WAREHOUSE_NAME": "TASTY_BYTES_DBT_WH",
